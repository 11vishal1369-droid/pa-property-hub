{
  "public": "build",
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/",
      "destination": "/admin/",
      "type": 302
    }
  ],
  "rewrites": [
    {
      "source": "admin",
      "destination": "/index.html"
    },
    {
      "source": "admin/**",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "static/**",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
